---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import FormattedDate from "../components/FormattedDate.astro";
import PostCard from "../components/PostCard.astro";
import AdSlot from "../components/AdSlot.astro";
import { AD_SLOTS, AUTHOR } from "../consts";
import { abs } from "../lib/url";

interface Props {
  post: CollectionEntry<"blog">;
}
const { post } = Astro.props;
const { data } = post;
const author = data.author ?? AUTHOR.name;

// Reading time + word count from the raw markdown body.
const words = (post.body ?? "").trim().split(/\s+/).filter(Boolean).length;
const readingTime = Math.max(1, Math.round(words / 200));

// Related posts: same category first, then fill with most-recent others.
const all = await getCollection("blog", ({ data }) => !data.draft);
const byDate = (a: CollectionEntry<"blog">, b: CollectionEntry<"blog">) =>
  b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
const related = all
  .filter((p) => p.id !== post.id && p.data.category === data.category)
  .sort(byDate);
if (related.length < 3) {
  const fill = all
    .filter((p) => p.id !== post.id && !related.includes(p))
    .sort(byDate)
    .slice(0, 3 - related.length);
  related.push(...fill);
}
const relatedPosts = related.slice(0, 3);

// ---- Structured data for this post ----
const breadcrumb = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Home", item: abs("/") },
    { "@type": "ListItem", position: 2, name: "Blog", item: abs("/blog") },
    {
      "@type": "ListItem",
      position: 3,
      name: data.category,
      item: abs(`/categories/${data.category.toLowerCase()}`),
    },
    { "@type": "ListItem", position: 4, name: data.title, item: abs(`/blog/${post.id}`) },
  ],
};

const recipeSchema = data.recipe
  ? {
      "@context": "https://schema.org",
      "@type": "Recipe",
      name: data.title,
      description: data.description,
      image: abs(data.heroImage ?? "/og-default.png"),
      author: { "@type": "Person", name: author },
      datePublished: data.pubDate.toISOString(),
      ...(data.recipe.prepTime ? { prepTime: data.recipe.prepTime } : {}),
      ...(data.recipe.cookTime ? { cookTime: data.recipe.cookTime } : {}),
      ...(data.recipe.totalTime ? { totalTime: data.recipe.totalTime } : {}),
      ...(data.recipe.recipeYield ? { recipeYield: data.recipe.recipeYield } : {}),
      ...(data.recipe.recipeCategory ? { recipeCategory: data.recipe.recipeCategory } : {}),
      ...(data.recipe.recipeCuisine ? { recipeCuisine: data.recipe.recipeCuisine } : {}),
      ...(data.recipe.calories
        ? { nutrition: { "@type": "NutritionInformation", calories: data.recipe.calories } }
        : {}),
      recipeIngredient: data.recipe.ingredients,
      recipeInstructions: data.recipe.instructions.map((step, i) => ({
        "@type": "HowToStep",
        position: i + 1,
        text: step,
      })),
    }
  : null;

const faqSchema =
  data.faq && data.faq.length
    ? {
        "@context": "https://schema.org",
        "@type": "FAQPage",
        mainEntity: data.faq.map((f) => ({
          "@type": "Question",
          name: f.question,
          acceptedAnswer: { "@type": "Answer", text: f.answer },
        })),
      }
    : null;

const jsonLd = [breadcrumb, recipeSchema, faqSchema].filter(Boolean) as Record<
  string,
  unknown
>[];
---

<BaseLayout
  title={data.title}
  description={data.description}
  type="article"
  image={data.heroImage}
  imageAlt={data.heroAlt}
  publishedTime={data.pubDate}
  modifiedTime={data.updatedDate}
  author={author}
  tags={data.tags}
  articleSection={data.category}
  wordCount={words}
  jsonLd={jsonLd}
>
  <article class="prose">
    <!-- Breadcrumb (visible) -->
    <nav class="post-meta" aria-label="Breadcrumb" style="margin-bottom:0.8rem;">
      <a href="/">Home</a> <span aria-hidden="true">›</span>
      <a href="/blog/">Blog</a> <span aria-hidden="true">›</span>
      <a href={`/categories/${data.category.toLowerCase()}/`}>{data.category}</a>
    </nav>

    <span class="badge">{data.category}</span>
    <h1>{data.title}</h1>

    <div class="post-meta">
      By <strong>{author}</strong>
      <span aria-hidden="true">•</span>
      <FormattedDate date={data.pubDate} />
      {
        data.updatedDate && (
          <>
            <span aria-hidden="true">•</span>
            <span>Updated <FormattedDate date={data.updatedDate} /></span>
          </>
        )
      }
      <span aria-hidden="true">•</span>
      <span>{readingTime} min read</span>
    </div>

    {
      data.sponsored && (
        <p class="disclosure">
          <strong>Disclosure:</strong> This post is sponsored / contains
          affiliate links. We may earn a commission at no extra cost to you.
        </p>
      )
    }

    {
      data.heroImage && (
        <img
          class="hero-image"
          src={data.heroImage}
          alt={data.heroAlt || data.title}
          width="1200"
          height="675"
          fetchpriority="high"
        />
      )
    }

    <!-- Article body -->
    <slot />

    <!-- In-article ad after the content -->
    <AdSlot slot={AD_SLOTS.inArticle} minHeight="280px" />

    {
      data.faq && data.faq.length > 0 && (
        <section class="faq" aria-labelledby="faq-heading">
          <h2 id="faq-heading">Frequently asked questions</h2>
          {data.faq.map((f) => (
            <details>
              <summary>{f.question}</summary>
              <p>{f.answer}</p>
            </details>
          ))}
        </section>
      )
    }

    {
      data.tags.length > 0 && (
        <p class="post-meta" style="margin-top:2rem;">
          {data.tags.map((t) => (
            <span class="badge" style="text-transform:none;">#{t}</span>
          ))}
        </p>
      )
    }
  </article>

  {
    relatedPosts.length > 0 && (
      <section class="related" aria-labelledby="related-heading">
        <h2 id="related-heading">Keep reading</h2>
        <div class="post-grid">
          {relatedPosts.map((p) => (
            <PostCard
              url={`/blog/${p.id}/`}
              title={p.data.title}
              description={p.data.description}
              pubDate={p.data.pubDate}
              category={p.data.category}
              heroImage={p.data.heroImage}
              heroAlt={p.data.heroAlt}
            />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
